{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Candlestick",
  "version": "1.0.2",
  "identifier": "com.candlestickers.dev",
  "build": {
    "frontendDist": [
      "../build"
    ],
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Candlestick",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "devtools": true,
        "minWidth": 320,
        "minHeight": 200,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "active": true,
    "targets": "all",
    "resources": [
      "../public/builtinlibrary"
    ],
    "fileAssociations": [
      {
        "ext": ["wick", "mov", "mp4"],
        "role": "Editor",
        "name": "Candlestick Project File"
      },{
        "ext": ["wickobj", "mp3", "wav", "png", "jpeg", "jpg", "gif"],
        "role": "Editor",
        "name": "Candlestick Asset File"
      }
    ]
  }
}
