{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Candlestick",
  "version": "0.1.0",
  "identifier": "com.candlestickers.dev",
  "build": {
    "frontendDist": [
      "../build"
    ],
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Candlestick",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.png",
      "../public/icon.icns"
    ],
    "resources": [
      "../public/builtinlibrary"
    ]
  }
}
